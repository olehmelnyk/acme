{
  "name": "@acme/workspace",
  "version": "0.0.0",
  "license": "CC-BY-NC-4.0",
  "keywords": [
    "nx",
    "nextjs",
    "playwright",
    "vitest",
    "storybook",
    "bun",
    "shadcn",
    "tailwind"
  ],
  "engines": {
    "node": ">=20.x",
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.0.0",
  "scripts": {
    "prepare": "husky",
    "preinstall": "npx only-allow bun",
    "test": "nx run-many --target=test --all",
    "test:coverage": "nx run-many --target=test --all --coverage",
    "test:watch": "nx run-many --target=test --all --watch",
    "test:e2e": "playwright test -c apps/web-e2e/playwright.config.ts",
    "e2e": "nx e2e web-e2e",
    "lint": "nx run-many --target=lint --all",
    "lint:fix": "nx run-many --target=lint --all --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "commit": "cz",
    "affected:apps": "nx affected:apps",
    "affected:libs": "nx affected:libs",
    "affected:build": "nx affected:build",
    "affected:e2e": "nx affected:e2e",
    "affected:test": "nx affected:test",
    "affected:lint": "nx affected:lint",
    "affected:dep-graph": "nx affected:dep-graph",
    "affected": "nx affected",
    "dep-graph": "nx dep-graph",
    "workspace-generator": "nx workspace-generator",
    "help": "nx help",
    "fix:types": "bun run tools/scripts/fix-types.ts",
    "docs:format": "bun run tools/docs-manager/src/cli/format-docs.ts format",
    "docs:format:check": "bun run tools/docs-manager/src/cli/format-docs.ts format --dry-run",
    "docs:format:fix": "bun run tools/docs-manager/src/cli/format-docs.ts format",
    "docs:maintain": "bun run docs:format:fix",
    "docs:xref": "bun tools/docs-manager/src/scripts/docs-xref.ts",
    "docs:generate": "bun run tools/docs-manager/src/cli/generate-docs.ts",
    "docs:cleanup": "bun run tools/docs-manager/src/cli/cleanup.ts",
    "docs:cleanup:all": "bun run tools/docs-manager/src/cli/cleanup.ts --all",
    "docs:validate": "bun run tools/docs-manager/src/cli/validate-diagrams.ts",
    "docs:validate:all": "bun run docs:format:check && bun run docs:xref --check && bun run docs:validate",
    "docs:index": "bun run tools/docs-manager/src/cli/generate-index.ts",
    "install:all": "bun tools/cleanup/src/cli/install-all.ts"
  },
  "private": true,
  "dependencies": {
    "@expo/metro-config": "~58.0.21",
    "@expo/metro-runtime": "~58.0.17",
    "@nx/expo": "24.0.4",
    "@testing-library/react": "^16.3.3",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "expo": "~58.0.23",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "inquirer": "^14.2.5",
    "lru-cache": "^11.5.3",
    "next": "^16.4.5",
    "openai": "^7.52.0",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-svg": "15.16.1",
    "react-native-svg-transformer": "1.5.3",
    "react-native-web": "~0.21.4",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@expo/cli": "~58.1.19",
    "@next/eslint-plugin-next": "^16.4.5",
    "@nx/devkit": "24.0.4",
    "@nx/eslint": "24.0.4",
    "@nx/eslint-plugin": "24.0.4",
    "@nx/js": "24.0.4",
    "@nx/next": "24.0.4",
    "@nx/playwright": "24.0.4",
    "@nx/react": "24.0.4",
    "@nx/react-native": "24.0.4",
    "@nx/storybook": "24.0.4",
    "@nx/vite": "24.0.4",
    "@nx/web": "24.0.4",
    "@playwright/test": "^1.65.0",
    "@secretlint/config-loader": "^13.1.0",
    "@secretlint/core": "^13.1.0",
    "@secretlint/formatter": "^13.1.0",
    "@secretlint/node": "^13.1.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/core-server": "8.6.14",
    "@storybook/nextjs": "^10.6.6",
    "@storybook/test-runner": "0.26.0",
    "@storybook/testing-library": "^0.2.2",
    "@swc-node/register": "~1.12.1",
    "@swc/core": "~1.16.22",
    "@swc/helpers": "~0.5.24",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/user-event": "^14.6.8",
    "@types/fs-extra": "^11.0.4",
    "@types/glob": "^9.0.0",
    "@types/node": "26.6.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "npm:types-react-dom@rc",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "^10.6.6",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nx": "24.0.4",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.3.1",
    "secretlint": "^13.1.0",
    "snyk": "^1.1308.4",
    "tailwindcss": "^4.3.4",
    "ts-jest": "^29.4.15",
    "ts-node": "10.9.2",
    "tslib": "^2.9.1",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "bin": {
    "acme-docs": "./scripts/docs/cli.ts"
  },
  "husky": {
    "hooks": {
      "pre-commit": "bun run docs:maintain && git add docs/architecture/diagram_index.md"
    }
  },
  "nx": {}
}
